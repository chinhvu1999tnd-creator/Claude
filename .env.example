# ============================================================
# AI Agent Business Kit — Environment Variables
# ============================================================
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# Chạy setup: node skills/integrations/email/scripts/setup-email.js
# ============================================================


# ── BUSINESS INFO ────────────────────────────────────────────
# Tên và thông tin cơ bản (dùng trong email, webhook noti, v.v.)
STORE_NAME=AI Agent Business Kit
STORE_EMAIL=hello@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=+84xxxxxxxxx
SITE_URL=https://your-site.vercel.app


# ── EMAIL PROVIDER ───────────────────────────────────────────
# Chọn 1: brevo (full sequences, khuyến nghị) | resend (transactional only)
# Xem: skills/integrations/email/SKILL.md
EMAIL_PROVIDER=brevo

# Brevo (dùng khi EMAIL_PROVIDER=brevo)
# Setup: brevo.com → Settings → API Keys
BREVO_API_KEY=xkeysib-
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME=Tên của bạn

# Brevo List IDs (tự động điền khi chạy setup-email.js)
BREVO_LIST_ID_LEADS=
BREVO_LIST_ID_CUSTOMERS=
BREVO_LIST_ID_REENGAGEMENT=
BREVO_LIST_ID_ABANDONED=

# Resend (dùng khi EMAIL_PROVIDER=resend)
# Setup: resend.com → API Keys
RESEND_API_KEY=re_
RESEND_SENDER_EMAIL=hello@yourdomain.com
RESEND_SENDER_NAME=Tên của bạn


# ── PAYMENT — SEPAY ──────────────────────────────────────────
# VietQR payment webhook (miễn phí)
# Setup: sepay.vn → Webhooks
SEPAY_API_TOKEN=
SEPAY_SECRET=
SEPAY_WEBHOOK_SECRET=


# ── NOTIFICATION — TELEGRAM ──────────────────────────────────
# Real-time noti khi có lead / đơn hàng mới
# Setup: t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Nhiều người nhận (cách nhau dấu phẩy): owner,team
TELEGRAM_CHAT_ID_OWNER=
TELEGRAM_CHAT_ID_TEAM=


# ── NOTIFICATION — ZALO ──────────────────────────────────────
# Zalo OA + ZNS cho admin alert và giao hàng cho khách VN
# Setup: node skills/deliver/zalo-notification/scripts/get-token.js
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=          # auto-filled bởi get-token.js
ZALO_OA_ID=                  # auto-filled bởi get-token.js
ZALO_ADMIN_USER_ID=          # Zalo user ID của owner

# ZNS Template IDs (điền sau khi template được Zalo duyệt, 1-2 ngày)
# Submit templates tại: skills/deliver/zalo-notification/templates/zns-templates.md
ZALO_ZNS_ORDER_TEMPLATE_ID=
ZALO_ZNS_DELIVERY_TEMPLATE_ID=
ZALO_ZNS_ABANDONED_TEMPLATE_ID=


# ── CUSTOMER PORTAL = CRM MẶC ĐỊNH ───────────────────────────
# ⭐ AUTO-FILLED bởi /coach setup-crm — KHÔNG cần điền tay.
# Coach deploy Portal lên Vercel → tự save URL vào đây + tạo MINICRM.md.
# CRM skill detect biến này → dùng Portal làm CRM (không hỏi menu).
# Để trống = chưa setup Portal → CRM skill gợi ý setup hoặc Google Sheets fallback.
CUSTOMER_PORTAL_URL=
CUSTOMER_PORTAL_WEBHOOK_SECRET=


# ── DIGITAL PRODUCT DELIVERY (SCENARIO B) ───────────────────
# Dùng khi KHÔNG có Customer Portal
PRODUCT_NAME=AI Agent Business Kit
ACCESS_LINK=https://github.com/your-repo
FUNNEL_SLUG=ai-agent-biz-kit
CHECKOUT_URL=https://your-site.vercel.app/order/


# ── IMAGE GENERATION ─────────────────────────────────────────
# GPT Image 2 — dùng cho content cards và landing page images
# Ưu tiên: Codex CLI → OpenAI → fal.ai
OPENAI_API_KEY=sk-
FAL_KEY=


# ── CRM — GOOGLE SHEETS (FALLBACK ONLY) ──────────────────────
# ⚠️ Fallback nhẹ — CHỈ dùng nếu KHÔNG setup Customer Portal.
# Customer Portal (phía trên) là CRM mặc định, mạnh hơn nhiều.
# Google Sheets chỉ lưu leads, không có member dashboard/auto-delivery/affiliate.
# Setup: skills/funnel/crm/SKILL.md (section Fallback CRM)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=


# ── APIFY (Optional — auto social analytics + competitor scraping) ─
# Dùng cho: /analyze social --auto, /analyze competitor, /offer competitor
# Free tier: $5/tháng credit (đủ cho weekly analytics)
# Setup: skills/setup/apify/references/get-token.md (~3 phút)
# Get token: https://console.apify.com/account/integrations
APIFY_TOKEN=


# ── DELIVERY — Giao sản phẩm sau thanh toán ──────────────────
# Agent TỰ detect từ hội thoại — không cần điền tay.
# Khi user nói "khách mua xong vào nhóm Telegram" → Agent set DELIVERY_METHOD=telegram
# Method: email | telegram | zalo | hybrid
DELIVERY_METHOD=email
# Telegram invite link (nếu method=telegram hoặc hybrid)
DELIVERY_TELEGRAM_INVITE=
# Zalo group link (nếu method=zalo hoặc hybrid)
DELIVERY_ZALO_GROUP=


# ── SECURITY ─────────────────────────────────────────────────
# JWT secret cho webhook verification (tự generate)
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
WEBHOOK_SECRET_TOKEN=


# ============================================================
# KHÔNG commit file .env lên git.
# .env.example là template an toàn để commit.
# ============================================================
