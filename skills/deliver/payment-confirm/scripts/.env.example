# SePay webhook secret (from SePay dashboard → Webhook settings)
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# Google Sheets CRM
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Telegram notifications
TELEGRAM_BOT_TOKEN=123456789:AABBccDDee...
TELEGRAM_CHAT_ID=-1001234567890

# Optional: direct deliver webhook trigger
DELIVER_WEBHOOK_URL=https://your-deliver-endpoint.vercel.app/api/deliver
